     server {
         listen 8888;
         server_name 192.168.118.200;
     
         access_log /var/log/nginx/apt-mirror_access.log;
         error_log /var/log/nginx/apt-mirror_error.log;
     
         root /srv/public;
     
          location /ubuntu/ {
              alias /srv/public/ubuntu/;
              autoindex on;
              autoindex_exact_size off;
              autoindex_localtime on;
     
              types {
                  application/octet-stream deb;
                  application/octet-stream udeb;
              }
     
              try_files $uri $uri/ =404;
          }
      }
